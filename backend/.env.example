# Copy this file to ".env" in the api/ directory on the server and fill in
# real values. The API also reads the same names from the process environment
# (hPanel → Advanced → Environment variables); real env vars win over .env.
#
# THE .env FILE IS BLOCKED FROM DIRECT HTTP ACCESS BY .htaccess — keep it
# out of version control regardless.

# Shared secret; the app sends this in the X-API-Key header.
# Default in code is "dev-key-change-me" — CHANGE IT.
MAILFLOW_API_KEY=change-me-to-a-long-random-string

# Sending identity.
MAILFLOW_MAILBOX=yesdaddy@celllaunch.shop

# IMAP (receive + delete). Host/port/encryption come from hPanel:
# "Emails → Connect Devices" (they are usually imap.hostinger.com:993/imap/ssl).
MAILFLOW_IMAP_HOST=imap.hostinger.com
MAILFLOW_IMAP_PORT=993
MAILFLOW_IMAP_ENCRYPTION=ssl
MAILFLOW_IMAP_USER=yesdaddy@celllaunch.shop
MAILFLOW_IMAP_PASS=REPLACE_WITH_MAILBOX_PASSWORD
# Optional: override the full IMAP mailbox string, e.g.
# MAILFLOW_IMAP_MAILBOX={imap.hostinger.com:993/imap/ssl}INBOX

# Max messages returned by GET /api/messages.php (newest first).
MAILFLOW_INBOX_BATCH=30

# SMTP (sending). Only needed if you set MAILFLOW_SMTP_HOST; otherwise the
# API falls back to PHP's built-in mail().
MAILFLOW_SMTP_HOST=smtp.hostinger.com
MAILFLOW_SMTP_PORT=587
MAILFLOW_SMTP_ENCRYPTION=tls
MAILFLOW_SMTP_USER=yesdaddy@celllaunch.shop
# Defaults to MAILFLOW_IMAP_PASS when left empty (Hostinger uses one password).
MAILFLOW_SMTP_PASS=